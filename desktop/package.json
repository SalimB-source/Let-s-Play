  },
  "scripts": {
    "icon": "node make-icon.mjs",
    "serve": "node local-server.js",
    "start": "electron .",
    "pack": "electron-builder --project pack --dir",
    "dist": "electron-builder --project pack --publish never"
  },
  "dependencies": {
