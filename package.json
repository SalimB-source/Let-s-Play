  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^30.1.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
