# Copy to .env.local for local development.
# On Vercel these are picked up automatically if you connected the Supabase
# integration (SUPABASE_URL / SUPABASE_ANON_KEY) — otherwise add the VITE_
# variables below in Vercel → Settings → Environment Variables and redeploy.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (aka "anon public" key): Supabase Dashboard → Settings → API.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
# Public Cloudflare Turnstile site key for the signup anti-bot challenge.
# Also enable Turnstile in Supabase → Authentication → CAPTCHA. Leave empty
# only for local builds where signup protection is not being tested.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
VITE_YOUTUBE_CHANNEL_ID=UCBi989OGXiGBjvB17Xh5GUQ

# Clé API YouTube Data v3 — côté SERVEUR uniquement, jamais de préfixe VITE_
# (sinon elle serait embarquée dans le bundle et rendue publique). Elle est
# lue par la fonction /api/youtube-live :
#   Vercel          → Project → Settings → Environment Variables
#   Cloudflare Pages → Pages project → Settings → Environment variables
# YOUTUBE_API_KEY=AIza...

# ── Appels vocaux & vidéo (src/messages/, en tête des discussions) ─────────
# Facultatif : serveur TURN (relais WebRTC) pour fiabiliser les appels derrière
# les NAT stricts — opérateurs mobiles, Wi-Fi d'hôtel… Sans TURN, les appels
# passent par le STUN public de Google (suffisant sur la plupart des box,
# aléatoire en 3G/4G). Plusieurs URLs acceptées, séparées par des virgules.
# À lire au build : redéployer après changement (voir README, « Appels »).
# VITE_TURN_URL=turn:turn.votre-domaine.com:3478
# VITE_TURN_USERNAME=letsplay
# VITE_TURN_CREDENTIAL=le-mot-de-passe-turn

# ── Robot actus du jour (scripts/news-bot/) ────────────────────────────────
# Optionnel : rédaction assistée par IA. Sans clé, le robot publie avec le
# gabarit éditorial (sources francophones uniquement). Sur GitHub, ces clés
# vont dans Settings → Secrets and variables → Actions (pas dans ce fichier).
# Une seule clé suffit ; NEWS_LLM_PROVIDER force un fournisseur (anthropic,
# openai, mistral ou gemini), NEWS_LLM_MODEL change le modèle par défaut.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# MISTRAL_API_KEY=...
# GEMINI_API_KEY=...
# NEWS_LLM_PROVIDER=openai
# NEWS_LLM_MODEL=gpt-4o-mini
# Nombre d’articles par run (défaut : 3) et forçage de run :
# NEWS_COUNT=3
# NEWS_FORCE=1

